---
import DualInfrastructureHero from '../components/hero/DualInfrastructureHero.astro';
import SectionRail from '../components/chrome/SectionRail.astro';
import SheetTitleBlock from '../components/chrome/SheetTitleBlock.astro';
import ThemeToggle from '../components/chrome/ThemeToggle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  { id: 'nu', number: '01', title: 'Nu', note: 'Huidige rol en werkgebied' },
  { id: 'traject', number: '02', title: 'Traject', note: 'Route door werk en opleiding' },
  {
    id: 'capaciteit',
    number: '03',
    title: 'Capaciteit',
    note: 'Vier disciplines, gelijkwaardig getekend',
  },
  { id: 'projecten', number: '04', title: 'Projecten', note: 'Probleem, aanpak en resultaat' },
  { id: 'buiten-werk', number: '05', title: 'Buiten werk', note: 'Ruimte buiten de lijnen' },
  {
    id: 'contact',
    number: '06',
    title: 'Contact',
    note: 'Directe lijn en technische verantwoording',
  },
] as const;
---

<BaseLayout title="Tim van Gorkom" description="Portfolio van Tim van Gorkom.">
  <SectionRail />
  <ThemeToggle />
  <main id="main-content" class="drawing-sheet">
    <DualInfrastructureHero />
    {sections.map(({ id, number, title, note }) => (
      <section
        id={id}
        class="sheet-section section-stub"
        data-sheet={title}
        aria-labelledby={`${id}-title`}
      >
        <span class="section-stub__number" aria-hidden="true">
          {number}
        </span>
        <div>
          <h2 id={`${id}-title`}>{title}</h2>
          <p>{note}</p>
        </div>
        <span class="section-stub__status">In uitwerking</span>
      </section>
    ))}
  </main>
  <SheetTitleBlock />
</BaseLayout>
