{
  "name": "tim-van-gorkom-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "22.x",
    "pnpm": "12.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun --config=lighthouse.config.cjs",
    "check:todos": "node scripts/check-todos.mjs",
    "check:bundle": "node scripts/assert-bundle-size.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "corepack pnpm check:todos && corepack pnpm format:check && corepack pnpm lint && corepack pnpm check && corepack pnpm build && corepack pnpm check:bundle && corepack pnpm check:links && corepack pnpm test:e2e && corepack pnpm test:lighthouse"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "5.18.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
